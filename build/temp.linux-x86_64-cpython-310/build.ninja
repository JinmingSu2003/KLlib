ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda-12.6/bin/nvcc

cflags = -pthread -B /home/glowing/miniconda3/envs/kllib/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/glowing/miniconda3/envs/kllib/include -fPIC -O2 -isystem /home/glowing/miniconda3/envs/kllib/include -fPIC -I/home/glowing/miniconda3/envs/kllib/lib/python3.10/site-packages/torch/include -I/home/glowing/miniconda3/envs/kllib/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-12.6/include -I/home/glowing/miniconda3/envs/kllib/include/python3.10 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C
cuda_cflags = -I/home/glowing/miniconda3/envs/kllib/lib/python3.10/site-packages/torch/include -I/home/glowing/miniconda3/envs/kllib/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda-12.6/include -I/home/glowing/miniconda3/envs/kllib/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 -gencode=arch=compute_86,code=sm_86 -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=_C
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /home/glowing/projects/KLlib/build/temp.linux-x86_64-cpython-310/src/cuda/gemm_kernel.o: cuda_compile /home/glowing/projects/KLlib/src/cuda/gemm_kernel.cu
